# MotoCare Super Admin Panel Environment Configuration

# Supabase Public Configuration (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Supabase Private Configuration (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# App Metadata Configuration
NEXT_PUBLIC_APP_NAME="MotoCare Admin"
NEXT_PUBLIC_APP_URL=http://localhost:3000
